    {
      "id": 8,
      "type": "table",
      "title": "Cada ligação",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Origem → destino, com chamadas, falhas, taxa de falha e a latência do percentil 95 vista por quem chama.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, server) (increase(traces_service_graph_request_total[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, server) (increase(traces_service_graph_request_failed_total[$__range])) or sum by (client, server) (increase(traces_service_graph_request_total[$__range])) * 0",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, client, server) (increase(traces_service_graph_request_client_seconds_bucket[$__range])))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Taxa de falha",
            "mode": "binary",
            "binary": {
              "left": "Value #B",
              "operator": "/",
              "right": "Value #A"
            },
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "client": 0,
              "server": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Taxa de falha": 4,
              "Value #C": 5
            },
            "renameByName": {
              "client": "Origem",
              "server": "Destino",
              "Value #A": "Chamadas",
              "Value #B": "Falhas",
              "Value #C": "Latência p95"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Chamadas",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "ainda sem chamadas entre serviços",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Chamadas"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Falhas"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Taxa de falha"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
