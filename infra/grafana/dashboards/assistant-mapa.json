    {
      "id": 2,
      "type": "nodeGraph",
      "title": "Mapa de serviços",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cada círculo é um serviço, banco ou provedor; cada seta é uma ligação, com o total de chamadas no período. A cor do círculo mostra a saúde (verde: sem falha; laranja: até 5% das chamadas recebidas falharam; vermelho: 5% ou mais) e o número dentro é a taxa de falha. \"user\" é quem chama a API de fora (a interface, o portal). Bancos (mysql, redis, qdrant) e provedores de modelo aparecem como destino das chamadas.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_join(round(sum by (client, server) (increase(traces_service_graph_request_total[$__range]))), \"id\", \"->\", \"client\", \"server\"), \"source\", \"$1\", \"client\", \"(.*)\"), \"target\", \"$1\", \"server\", \"(.*)\")",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace((max by (id, title) (label_replace(label_replace(round(100 * sum by (server) (increase(traces_service_graph_request_failed_total[$__range])) / on (server) clamp_min(sum by (server) (increase(traces_service_graph_request_total[$__range])), 1)), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\") or label_replace(label_replace(0 * sum by (server) (increase(traces_service_graph_request_total[$__range])), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\") or label_replace(label_replace(0 * sum by (client) (increase(traces_service_graph_request_total[$__range])), \"id\", \"$1\", \"client\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\")) >= 5), \"color\", \"red\", \"id\", \".*\") or label_replace(((max by (id, title) (label_replace(label_replace(round(100 * sum by (server) (increase(traces_service_graph_request_failed_total[$__range])) / on (server) clamp_min(sum by (server) (increase(traces_service_graph_request_total[$__range])), 1)), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\") or label_replace(label_replace(0 * sum by (server) (increase(traces_service_graph_request_total[$__range])), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\") or label_replace(label_replace(0 * sum by (client) (increase(traces_service_graph_request_total[$__range])), \"id\", \"$1\", \"client\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\")) > 0) and (max by (id, title) (label_replace(label_replace(round(100 * sum by (server) (increase(traces_service_graph_request_failed_total[$__range])) / on (server) clamp_min(sum by (server) (increase(traces_service_graph_request_total[$__range])), 1)), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\") or label_replace(label_replace(0 * sum by (server) (increase(traces_service_graph_request_total[$__range])), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\") or label_replace(label_replace(0 * sum by (client) (increase(traces_service_graph_request_total[$__range])), \"id\", \"$1\", \"client\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\")) < 5)), \"color\", \"orange\", \"id\", \".*\") or label_replace((max by (id, title) (label_replace(label_replace(round(100 * sum by (server) (increase(traces_service_graph_request_failed_total[$__range])) / on (server) clamp_min(sum by (server) (increase(traces_service_graph_request_total[$__range])), 1)), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\") or label_replace(label_replace(0 * sum by (server) (increase(traces_service_graph_request_total[$__range])), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\") or label_replace(label_replace(0 * sum by (client) (increase(traces_service_graph_request_total[$__range])), \"id\", \"$1\", \"client\", \"(.*)\"), \"title\", \"$1\", \"id\", \"(.*)\")) == 0), \"color\", \"green\", \"id\", \".*\")",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "m",
              "Value #B": "m"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "mainstat",
            "mode": "binary",
            "binary": {
              "left": "m",
              "operator": "*",
              "right": "1"
            },
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "m": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "ainda sem chamadas entre serviços"
        },
        "overrides": []
      },
      "options": {
        "nodes": {
          "mainStatUnit": "%"
        },
        "edges": {
          "mainStatUnit": " chamadas"
        }
      }
    },
    {
