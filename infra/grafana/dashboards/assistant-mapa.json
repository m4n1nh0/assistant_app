      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(traces_service_graph_request_total[$__range]))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
