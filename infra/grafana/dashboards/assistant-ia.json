    {
      "id": 12,
      "type": "table",
      "title": "Consumo por modelo",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "appdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "appdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS Provedor, IF(model = '', '(sem modelo)', model) AS Modelo, SUM(calls) AS Chamadas, SUM(errors) AS Falhas, SUM(input_tokens) AS Entrada, SUM(output_tokens) AS Saida, SUM(cost_usd) AS Custo FROM llm_usage_daily WHERE day BETWEEN DATE_FORMAT($__timeFrom(), '%Y-%m-%d') AND DATE_FORMAT($__timeTo(), '%Y-%m-%d') GROUP BY provider, model ORDER BY Custo DESC, Chamadas DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "sem consumo no período",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Custo"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chamadas"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Falhas"
            },
            "properties": [
              {
                "id": "unit",
