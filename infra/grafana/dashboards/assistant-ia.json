        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Custo estimado",
      "description": "No período escolhido na lista \"Período do consumo\". Tokens x preço de tabela do modelo (aba Preços do app): é uma estimativa, e o valor real depende do seu contrato.",
      "datasource": {
        "type": "mysql",
        "uid": "appdb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "appdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(cost_usd), 0) AS value FROM llm_usage_hourly WHERE bucket >= UTC_TIMESTAMP() - INTERVAL ${dias} DAY",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
