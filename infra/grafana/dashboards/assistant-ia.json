          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(bucket, 1d), CONCAT(provider, ' / ', IF(model = '', '(sem modelo)', model)) AS metric, SUM(cost_usd) AS value FROM llm_usage_hourly WHERE bucket >= DATE_FORMAT($__timeFrom(), '%Y-%m-%d 00:00:00') AND bucket <= $__timeTo() GROUP BY 1, 2 HAVING SUM(cost_usd) > 0 ORDER BY 1",
