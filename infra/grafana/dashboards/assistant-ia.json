          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(assistant_llm_calls_total{ok=\"false\"}[24h])) / clamp_min(sum(increase(assistant_llm_calls_total[24h])), 1)",
