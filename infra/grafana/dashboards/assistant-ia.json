          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS Provedor, IF(model = '', '(sem modelo)', model) AS Modelo, SUM(calls) AS Chamadas, SUM(errors) AS Falhas, SUM(input_tokens) AS Entrada, SUM(output_tokens) AS Saida, SUM(cost_usd) AS Custo FROM llm_usage_hourly WHERE bucket >= UTC_TIMESTAMP() - INTERVAL ${dias} DAY GROUP BY provider, model ORDER BY Custo DESC, Chamadas DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
