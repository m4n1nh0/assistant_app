          "rawSql": "SELECT UNIX_TIMESTAMP(day) AS time, provider AS metric, SUM(calls - errors) AS value FROM llm_usage_daily WHERE day BETWEEN DATE_FORMAT($__timeFrom(), '%Y-%m-%d') AND DATE_FORMAT($__timeTo(), '%Y-%m-%d') GROUP BY day, provider ORDER BY day",
