    {
      "id": 12,
      "type": "timeseries",
      "title": "Taxa de falha por provedor (% das chamadas)",
      "description": "De cada 100 chamadas a um provedor, quantas falharam no dia. 100% significa que nenhuma funcionou: chave ausente ou inválida, sem crédito ou provedor fora do ar. Últimos 30 dias.",
      "datasource": {
        "type": "mysql",
        "uid": "appdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "appdb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(bucket, 1d), provider AS metric, SUM(errors) / SUM(calls) AS value FROM llm_usage_hourly WHERE bucket >= DATE_FORMAT($__timeFrom(), '%Y-%m-%d 00:00:00') AND bucket <= $__timeTo() GROUP BY 1, 2 HAVING SUM(calls) > 0 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "sem consumo no período",
          "custom": {
            "drawStyle": "line",
            "barAlignment": 0,
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 1
          }
        },
        "overrides": []
