    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens: últimas 24 horas, hora a hora",
      "description": "Entrada + saída por provedor, uma barra por hora. Período fixo de 24 horas: não muda com o seletor. O consumo anterior à tabela por hora só tem o total do dia, então aparece nos gráficos dia a dia, e não neste.",
      "datasource": {
        "type": "mysql",
        "uid": "appdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "appdb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(bucket, $__interval), provider AS metric, SUM(input_tokens + output_tokens) AS value FROM llm_usage_hourly WHERE bucket >= DATE_FORMAT($__timeFrom(), '%Y-%m-%d %H:00:00') AND bucket <= $__timeTo() AND legacy = 0 GROUP BY 1, 2 HAVING SUM(input_tokens + output_tokens) > 0 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "sem consumo por hora nas últimas 24 horas",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 75,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "timeFrom": "24h",
      "interval": "1h"
    },
