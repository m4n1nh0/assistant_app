# Collector no Railway.
#
# O compose monta infra/otel-collector.yaml por volume; o Railway nao monta arquivo do
# repositorio numa imagem pronta. Aqui o mesmo arquivo e copiado para dentro da imagem, e a
# versao do collector e a mesma do compose.
#
# Root Directory: /infra
# Dockerfile Path: /infra/Dockerfile.otel-collector
FROM otel/opentelemetry-collector-contrib:0.115.1

COPY otel-collector.yaml /etc/otelcol-contrib/config.yaml

EXPOSE 4317 4318
