# =============================================================================
# mcp-service - os servidores MCP em processo proprio
# =============================================================================
#
#   cp .env.mcp-service.example .env.mcp-service
#
# Em PaaS, cole o conteudo nas variaveis do servico. Referencia completa:
# docs/configuracao-por-servico.md
#
# Sao 20 variaveis e nenhum segredo de aplicacao. Este processo nao conhece
# banco, JWT, provedor de LLM nem Qdrant - esses modulos nem entram no fecho de
# imports dele.

# --- processo ----------------------------------------------------------------
HOST=0.0.0.0

# Porta em que o processo escuta. Em PaaS a plataforma injeta PORT e roteia para
# ela; fixar o valor aqui e o que torna a URL interna
# (mcp-service.railway.internal:8002) uma constante em vez de uma surpresa.
# NAO use MCP_SERVICE_PORT em PaaS: perde para PORT e so confunde o diagnostico.
PORT=8002

# Obrigatorio em qualquer ambiente implantado. O padrao do Settings e `true`, e
# `serve()` repassa isso ao uvicorn: sem esta linha o container sobe um file
# watcher para vigiar arquivos que nunca mudam.
RELOAD=false

LOG_LEVEL=info

# --- obrigatoria: quais servidores MCP subir ---------------------------------
# JSON, mapa {"nome": {...}} ou lista com "name".
#   stdio: {"fs": {"command": "npx", "args": ["-y", "@mcp/server-fs", "/dados"]}}
#   http:  {"docs": {"url": "http://localhost:3000/mcp"}}
#
# ATENCAO ao transporte stdio: ele sobe um SUBPROCESSO dentro deste container, e
# o runtime dele precisa existir na imagem. O backend/Dockerfile tem Python,
# ffmpeg e curl - nao tem Node. Um servidor com `npx` so funciona se voce
# acrescentar Node ao Dockerfile; servidores `http` nao tem esse requisito.
#
# Vazio e um estado valido: o servico sobe, responde /health/live e reporta
# /health/ready {"ok": true, "configured": false, "servers": 0}. Instalacao que
# nao usa MCP nao e falha.
MCP_SERVERS=

# --- resiliencia -------------------------------------------------------------
# Mantenha estes valores IGUAIS aos da assistant-api e do tool-service: os tres
# falam com o mesmo servidor, e timeout divergente produz comportamento
# inconsistente sob falha.
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=2
MCP_RETRY_BACKOFF_SECONDS=0.5
# O disjuntor evita pagar o timeout inteiro a cada mensagem quando um servidor
# esta fora do ar.
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_RESET_SECONDS=60
MCP_TOOLS_CACHE_TTL_SECONDS=300

# --- observabilidade ---------------------------------------------------------
# OTEL_EXPORTER_ENDPOINT precisa ser o mesmo dos outros servicos, senao os spans
# dos quatro processos nao formam um trace so.
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
TELEMETRY_MEMORY_EVENTS=2000

# OTEL_SERVICE_NAME nao entra aqui: so a assistant-api a le. Este processo passa
# o proprio nome no codigo, em create_service(name="mcp-service").
#
# LANGSMITH_* e LLM_PRICING tambem nao. Elas SAO lidas no boot - todo entrypoint
# chama setup_observability() -, mas nao ha componente LangChain neste processo
# para gerar trace. Variavel lida e sem efeito e credencial exposta de graca.

# --- o que NAO colocar aqui --------------------------------------------------
# DATABASE_URL, REDIS_URL, QDRANT_*, JWT_SECRET, SECRET_KEY, CORS_ORIGINS,
# CREDENTIAL_ENCRYPTION_KEY, chaves de provedor (CLAUDE_API_KEY e afins).
# Nenhuma e lida por este processo.
