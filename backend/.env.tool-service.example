# =============================================================================
# tool-service - o catalogo de ferramentas em processo proprio
# =============================================================================
#
#   cp .env.tool-service.example .env.tool-service
#
# Em PaaS, cole o conteudo nas variaveis do servico. Referencia completa:
# docs/configuracao-por-servico.md
#
# Sao 21 variaveis no arranjo recomendado (MCP remoto). Este servico roda o
# mesmo registry e o mesmo executor que o modo in-process usa - e por isso que
# mover o catalogo para fora nao muda regra de autorizacao, timeout nem
# auditoria. O que muda e so o transporte.

# --- processo ----------------------------------------------------------------
HOST=0.0.0.0

# Em PaaS a plataforma injeta PORT; fixar aqui torna a URL interna
# (tool-service.railway.internal:8003) constante.
# NAO use TOOL_SERVICE_PORT em PaaS: perde para PORT.
PORT=8003

# Obrigatorio em ambiente implantado: o padrao do Settings e `true` e `serve()`
# repassa ao uvicorn.
RELOAD=false

LOG_LEVEL=info

# --- execucao de ferramenta --------------------------------------------------
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_RETRIES=1
TOOL_RETRY_BACKOFF_SECONDS=0.5

# --- de onde vem as capacidades MCP ------------------------------------------
# Este servico PUBLICA as capacidades MCP no catalogo, entao precisa de um
# caminho ate elas. Com `remote`, quem sobe os servidores e o mcp-service e aqui
# so trafega HTTP - e o arranjo recomendado, porque servidor stdio sobe
# subprocesso e subprocesso quer isolamento.
MCP_TRANSPORT=remote
# Docker Compose:  http://mcp-service:8002
# Railway:         http://mcp-service.railway.internal:8002
# A porta e a que o mcp-service realmente abriu. Se voce nao fixou PORT la, ela
# esta no log de boot dele: "... escutando em 0.0.0.0:<porta>".
MCP_SERVICE_URL=http://mcp-service:8002

# Iguais as do mcp-service e da assistant-api.
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=2
MCP_RETRY_BACKOFF_SECONDS=0.5

# Com MCP_TRANSPORT=local, comente as duas linhas acima, declare os servidores
# em MCP_SERVERS e acrescente MCP_TOOLS_CACHE_TTL_SECONDS,
# MCP_CIRCUIT_FAILURE_THRESHOLD e MCP_CIRCUIT_RESET_SECONDS: o cliente direto
# usa cache e disjuntor, o gateway remoto nao.
# MCP_SERVERS=

# --- observabilidade ---------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
TELEMETRY_MEMORY_EVENTS=2000

# OTEL_SERVICE_NAME nao entra: o nome vem de create_service(name="tool-service").
# LANGSMITH_* e LLM_PRICING sao lidas no boot mas nao tem efeito aqui - nao ha
# chamada de modelo neste processo.

# --- o que NAO colocar aqui --------------------------------------------------
# DATABASE_URL, JWT_SECRET, SECRET_KEY, CREDENTIAL_ENCRYPTION_KEY.
#
# Elas aparecem no fecho de imports - montar o catalogo carrega
# app.core.database, app.core.security e credential_storage_service -, mas
# NENHUM codigo executado por este servico as utiliza: as ferramentas daqui so
# montam proposta, quem executa e a interface apos confirmacao do usuario. Sem
# as variaveis, o padrao do Settings e usado, o engine do SQLAlchemy e
# construido e fica ocioso, e nada quebra. Definir um DATABASE_URL real seria
# dar ao servico uma credencial que ele nao precisa.
#
# Tambem nao entram: REDIS_URL, QDRANT_*, CORS_ORIGINS, chaves de provedor.

# --- healthcheck -------------------------------------------------------------
# Use /health/live na plataforma, nunca /health/ready: o `ready` daqui so
# responde ok:true com pelo menos uma ferramenta publicada, e um catalogo
# momentaneamente vazio viraria loop de restart.
