# =============================================================================
# agent-orchestrator - o grafo do chat exposto como servico proprio
# =============================================================================
#
#   cp .env.orchestrator.example .env.orchestrator
#
# Referencia completa: docs/arquitetura/configuracao-por-servico.md
# Railway (bloco pronto, start command, watch paths): docs/arquitetura/deploy-railway.md
#
# A assistant-api entrega cada turno aqui quando ORCHESTRATOR_TRANSPORT=remote.
# As chaves de provedor NAO viajam: este processo decifra as do usuario a partir
# do banco, pelo tutor_id - por isso precisa do mesmo DATABASE_URL e da mesma
# CREDENTIAL_ENCRYPTION_KEY da assistant-api.
#
# Nao de dominio publico a este servico. As rotas /orchestrate/* exigem
# X-Internal-Token, mas o servico nao tem motivo para ser alcancado de fora.

# --- processo ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
# NAO use ORCHESTRATOR_PORT em PaaS: perde para PORT.
RELOAD=false
LOG_LEVEL=info

# --- entre servicos (obrigatorias) --------------------------------------------
# Mesmo valor na assistant-api. Vazio: todo turno e recusado com 503.
INTERNAL_SERVICE_TOKEN=
# Por onde uma capacidade da maquina do usuario volta ao WebSocket da sessao.
# Docker Compose:  http://backend:8000
# Railway:         http://<assistant-api>.railway.internal:<porta>
ASSISTANT_API_URL=http://backend:8000

# --- dados e credenciais (iguais aos da assistant-api) ------------------------
DATABASE_URL=mysql+aiomysql://assistant:assistant@mysql:3306/assistant
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
SECRET_KEY=
# Sem ela, ou com valor diferente da API, as chaves salvas no banco nao abrem e
# nenhum provedor de nuvem fica disponivel.
CREDENTIAL_ENCRYPTION_KEY=

# --- busca semantica (RAG das aulas) ------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=assistant
QDRANT_VECTOR_SIZE=384
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=

# --- provedores locais (infraestrutura, iguais aos da assistant-api) ----------
OLLAMA_BASE_URL=
LOCALAI_BASE_URL=
LOCALAI_MODEL=
LOCALAI_API_KEY=
LOCAL_LLM_CONTEXT_TOKENS=8192

# --- ferramentas e MCP (o agente roda aqui) -----------------------------------
TOOL_TRANSPORT=local
TOOL_SERVICE_URL=
MCP_TRANSPORT=local
MCP_SERVICE_URL=
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_RETRIES=1
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=2
MCP_RETRY_BACKOFF_SECONDS=0.5

# --- grafo ---------------------------------------------------------------------
AGENT_MAX_TOOL_ITERATIONS=3
AGENT_MAX_HANDOFFS=2
# `memory` vive neste processo: com mais de uma replica do orquestrador, a
# retomada so funciona na replica que gravou. `sqlite` exige volume.
CHECKPOINT_BACKEND=memory
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
CHECKPOINT_MAX_THREADS=200
GRAPH_NODE_MAX_RETRIES=2

# --- observabilidade -----------------------------------------------------------
# Aqui LANGSMITH_* tem efeito real: e neste processo que o grafo LangGraph roda.
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
TELEMETRY_MEMORY_EVENTS=2000
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assistant-app
LANGSMITH_ENDPOINT=
LLM_PRICING=
