# =============================================================================
# agent-orchestrator - o grafo do chat exposto como servico proprio
# =============================================================================
#
#   cp .env.orchestrator.example .env.orchestrator
#
# Referencia completa: docs/configuracao-por-servico.md
#
# LEIA ANTES DE USAR. Este entrypoint existe para manter a opcao aberta, nao
# porque a extracao ja se justifique. As credenciais de nuvem sao de cada
# usuario, ficam cifradas no banco e sao decifradas POR REQUISICAO num
# ContextVar; um orquestrador em outro processo precisaria receber essas chaves
# pela rede a cada mensagem - trocando seguranca por um isolamento que, num
# backend que roda na maquina do usuario, nao resolve problema nenhum.
#
# Use para: teste de carga isolado do fluxo agentivo, e o dia em que API e
# orquestracao precisarem escalar separado.

# --- processo ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
# NAO use ORCHESTRATOR_PORT em PaaS: perde para PORT.
RELOAD=false
LOG_LEVEL=info

# --- checkpointing do grafo --------------------------------------------------
# `memory` nao sobrevive a restart, mas cobre a retomada dentro da mesma sessao
# sem dependencia extra. `sqlite` persiste entre reinicios, e exige
# langgraph-checkpoint-sqlite instalado E um volume montado - em container
# efemero, o arquivo some junto com o container.
CHECKPOINT_BACKEND=memory
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite

# Teto de conversas retidas em memoria. O InMemorySaver do LangGraph nunca
# descarta nada: sem teto, um processo de vida longa acumula todo checkpoint ja
# gravado. Medido neste projeto: ~7 KB por conversa de uma mensagem; com o teto
# em 200 a memoria estabiliza em ~1,4 MB depois de milhares de conversas.
CHECKPOINT_MAX_THREADS=200

GRAPH_NODE_MAX_RETRIES=2

# --- observabilidade ---------------------------------------------------------
# Aqui LANGSMITH_* tem efeito real, diferente do mcp-service e do tool-service:
# e neste processo que o grafo LangGraph roda.
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
TELEMETRY_MEMORY_EVENTS=2000
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assistant-app
LANGSMITH_ENDPOINT=
# LLM_PRICING sobrescreve a tabela interna de preco por milhao de tokens:
# {"claude": {"input": 3.0, "output": 15.0}}
LLM_PRICING=

# --- para ATENDER requisicao, e nao so subir ---------------------------------
# As 8 variaveis acima (mais as de observabilidade) bastam para o processo subir
# e passar no healthcheck. Responder POST /orchestrate/chat de verdade exige o
# mesmo que a assistant-api precisa - e por isso que este servico nao e extraido
# por padrao. Descomente conforme for ligando o fluxo:
#
# AGENT_MAX_TOOL_ITERATIONS=3
# AGENT_MAX_HANDOFFS=2
# DATABASE_URL=mysql+aiomysql://assistant:assistant@mysql:3306/assistant
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# EMBEDDING_PROVIDER=auto
# CREDENTIAL_ENCRYPTION_KEY=
# JWT_SECRET=
# ... e o bloco de provedores do .env.example
