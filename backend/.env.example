# Assistant Backend - environment settings
# Copy to .env only for infrastructure/runtime values.
# App credentials such as notifications and calendar OAuth are saved in the database.

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-long-random-string-in-production
CORS_ORIGINS=http://localhost,http://127.0.0.1

# LLM providers
CLAUDE_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
HUGGINGFACE_API_KEY=

# LLM models
GROK_MODEL=grok-3
GROQ_MODEL=llama-3.3-70b-versatile
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
OPENROUTER_MODEL=openrouter/auto
DEEPSEEK_MODEL=deepseek-chat
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional LocalAI provider (OpenAI-compatible API).
# Railway: http://${{localai.RAILWAY_PRIVATE_DOMAIN}}:8080
LOCALAI_BASE_URL=
# Set an explicit model in production so cold LocalAI instances can be detected
# through /api/models/config-json/{model}; empty uses the first /v1/models item.
LOCALAI_MODEL=
# Optional; required only when API-key authentication is enabled in LocalAI.
LOCALAI_API_KEY=

# Auth token signing
JWT_SECRET=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Optional first-admin registration invite.
# When enabled, the first admin account also requires a one-time token sent to
# REGISTRATION_ADMIN_EMAIL. After setup, only that admin can invite more users.
REGISTRATION_INVITE_REQUIRED=false
REGISTRATION_ADMIN_EMAIL=
REGISTRATION_TOKEN_EXPIRE_MINUTES=30
REGISTRATION_TOKEN_REQUEST_COOLDOWN_SECONDS=60

# Delivers both the first-admin token and later user invitations via the
# Brevo transactional email HTTP API (not SMTP - many PaaS hosts block
# outbound SMTP ports, so the API avoids that entirely).
SMTP_FROM=
BREVO_API_KEY=

# Database and vector store
DATABASE_URL=mysql+aiomysql://assistant:assistant@localhost:3306/assistant
# Optional one-time demo data seed. Supported value: demo-v1
DATABASE_SEED=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=assistant
QDRANT_VECTOR_SIZE=384

# Embeddings semanticos usados pelo modo educacao (transcricao de aulas).
# "auto" tenta, nesta ordem: EMBEDDING_BASE_URL, LocalAI, Ollama, OpenAI e por
# fim um hash offline (busca vira palavra-exata). Valores aceitos:
# auto | custom | localai | ollama | openai | hash
EMBEDDING_PROVIDER=auto
# Vazio usa o padrao do provedor: nomic-embed-text (Ollama),
# text-embedding-ada-002 (LocalAI), text-embedding-3-small (OpenAI).
# No Ollama, baixe antes: ollama pull nomic-embed-text
EMBEDDING_MODEL=
# Endpoint proprio compativel com a API da OpenAI (vLLM, TEI, LM Studio...).
# Informe a raiz; o sufixo /v1/embeddings e adicionado automaticamente.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 0 detecta a dimensao perguntando ao provedor na primeira chamada.
EMBEDDING_DIMENSIONS=0

# Modo educacao: tamanho do bloco de audio enviado pela interface e limite de
# caracteres por rodada de resumo (acima disso o resumo vira mapa-reducao).
EDUCATION_SEGMENT_SECONDS=60
EDUCATION_SUMMARY_MAX_CHARS=24000
EDUCATION_MIN_SEGMENT_CHARS=12

# Redis backs per-IP rate limiting (fastapi-limiter). If unreachable, the
# backend still starts and rate limiting is simply skipped.
REDIS_URL=redis://localhost:6379/0

# Local speech-to-text.
# Com GPU NVIDIA, use cuda/float16: fica cerca de 7x mais rapido que cpu/int8
# com o mesmo acerto. Exige os pacotes nvidia-cublas-cu12 e nvidia-cudnn-cu12
# (ja em requirements.txt); o backend poe essas DLLs no PATH sozinho.
# Sem GPU, volte para cpu/int8.
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_VAD_FILTER=true
WHISPER_VAD_MIN_SILENCE_MS=500

# Speech providers
STT_PROVIDER=local
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=0.95
