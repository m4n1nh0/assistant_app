# Assistant Backend - environment settings
# Copy to .env only for infrastructure/runtime values.
# App credentials such as notifications and calendar OAuth are saved in the database.

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-long-random-string-in-production
CORS_ORIGINS=http://localhost,http://127.0.0.1

# LLM providers
CLAUDE_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
HUGGINGFACE_API_KEY=

# LLM models
GROK_MODEL=grok-3
GROQ_MODEL=llama-3.3-70b-versatile
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
OPENROUTER_MODEL=openrouter/auto
DEEPSEEK_MODEL=deepseek-chat
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional LocalAI provider (OpenAI-compatible API).
# Railway: http://${{localai.RAILWAY_PRIVATE_DOMAIN}}:8080
LOCALAI_BASE_URL=
# Leave empty to use the first model returned by /v1/models.
LOCALAI_MODEL=
# Optional; required only when API-key authentication is enabled in LocalAI.
LOCALAI_API_KEY=

# Auth token signing
JWT_SECRET=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database and vector store
DATABASE_URL=mysql+aiomysql://assistant:assistant@localhost:3306/assistant
# Optional one-time demo data seed. Supported value: demo-v1
DATABASE_SEED=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=assistant
QDRANT_VECTOR_SIZE=384

# Local speech-to-text
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_VAD_FILTER=true
WHISPER_VAD_MIN_SILENCE_MS=500

# Speech providers
STT_PROVIDER=local
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=0.95
