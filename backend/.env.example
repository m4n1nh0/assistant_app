# Assistant Backend - environment settings (assistant-api)
# Copy to .env only for infrastructure/runtime values.
#
# Este arquivo e o da assistant-api, o processo que le praticamente todo o
# Settings. Os servicos extraidos tem os seus, bem menores:
#   .env.mcp-service.example    .env.tool-service.example
#   .env.orchestrator.example
# Qual variavel pertence a qual processo: docs/configuracao-por-servico.md
# User settings are saved in the database. Provider application secrets stay here
# or in the deployment secret manager and are never sent to the interface.

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-long-random-string-in-production
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Legacy bootstrap model defaults for those external providers.
GROK_MODEL=grok-3
GROQ_MODEL=llama-3.3-70b-versatile
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
OPENROUTER_MODEL=openrouter/auto
DEEPSEEK_MODEL=deepseek-chat
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Local providers below are installation-wide infrastructure.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional LocalAI provider (OpenAI-compatible API).
# Railway: http://${{localai.RAILWAY_PRIVATE_DOMAIN}}:8080
LOCALAI_BASE_URL=
# Set an explicit model in production so cold LocalAI instances can be detected
# through /api/models/config-json/{model}; empty uses the first /v1/models item.
LOCALAI_MODEL=
# Optional; required only when API-key authentication is enabled in LocalAI.
LOCALAI_API_KEY=

# Auth token signing
JWT_SECRET=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Stable random value used to encrypt OAuth refresh tokens at rest. Do not rotate
# without reconnecting the accounts already stored in the database.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-value

# Microsoft delegated login. This is one multitenant Web App Registration owned
# by the deployment, not an app registered in each user's organization. Configure
# supported accounts as organizational directories + personal Microsoft accounts.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common

# Optional first-admin registration invite.
# When enabled, the first admin account also requires a one-time token sent to
# REGISTRATION_ADMIN_EMAIL. After setup, only that admin can invite more users.
REGISTRATION_INVITE_REQUIRED=false
REGISTRATION_ADMIN_EMAIL=
REGISTRATION_TOKEN_EXPIRE_MINUTES=30
REGISTRATION_TOKEN_REQUEST_COOLDOWN_SECONDS=60
# Recovery tokens are delivered to the email already linked to the account.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60

# Delivers registration, invitation and account-recovery tokens via the Brevo
# transactional email HTTP API (not SMTP - many PaaS hosts block
# outbound SMTP ports, so the API avoids that entirely).
SMTP_FROM=
BREVO_API_KEY=

# Database and vector store
DATABASE_URL=mysql+aiomysql://assistant:assistant@localhost:3306/assistant
# Optional one-time demo data seed. Supported value: demo-v1
DATABASE_SEED=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=assistant
QDRANT_VECTOR_SIZE=384

# Embeddings semanticos usados pelo modo educacao (transcricao de aulas).
# "auto" tenta, nesta ordem: EMBEDDING_BASE_URL, LocalAI, Ollama, OpenAI e por
# fim um hash offline (busca vira palavra-exata). Valores aceitos:
# auto | custom | localai | ollama | openai | hash
EMBEDDING_PROVIDER=auto
# Vazio usa o padrao do provedor: nomic-embed-text (Ollama),
# text-embedding-ada-002 (LocalAI), text-embedding-3-small (OpenAI).
# No Ollama, baixe antes: ollama pull nomic-embed-text
EMBEDDING_MODEL=
# Endpoint proprio compativel com a API da OpenAI (vLLM, TEI, LM Studio...).
# Informe a raiz; o sufixo /v1/embeddings e adicionado automaticamente.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 0 detecta a dimensao perguntando ao provedor na primeira chamada.
EMBEDDING_DIMENSIONS=0

# Servidores MCP expostos aos agentes, em JSON. Vazio desliga o MCP.
# Mapa:  {"fs": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/projetos"]}}
# HTTP:  {"docs": {"url": "http://localhost:3000/mcp"}}
# O transporte e inferido: "command" vira stdio, "url" vira streamable_http.
MCP_SERVERS=
# Teto de voltas do ciclo modelo -> ferramenta -> modelo por resposta.
AGENT_MAX_TOOL_ITERATIONS=3
# Quantas vezes um agente pode transferir a conversa para outro (A2A).
AGENT_MAX_HANDOFFS=2

# Modo educacao: tamanho do bloco de audio enviado pela interface e limite de
# caracteres por rodada de resumo (acima disso o resumo vira mapa-reducao).
EDUCATION_SEGMENT_SECONDS=60
EDUCATION_SUMMARY_MAX_CHARS=24000
EDUCATION_MIN_SEGMENT_CHARS=12
# Tempo maximo de uma tentativa completa de resumo por provedor. No modo auto,
# timeout/erro avanca para o proximo provedor disponivel.
EDUCATION_SUMMARY_PROVIDER_TIMEOUT_SECONDS=180
# Evita percorrer todos os provedores configurados em uma unica requisicao.
EDUCATION_SUMMARY_MAX_PROVIDERS=3
# LocalAI e Ollama sempre vem primeiro. Desative para nunca usar API paga como
# fallback automatico de resumo.
EDUCATION_SUMMARY_ALLOW_PAID_FALLBACK=true

# Janela de contexto do modelo local usado no resumo (LocalAI e Ollama). O
# resumo fatia a transcricao por esse numero; se o servidor foi subido com uma
# janela maior, aumente aqui: o resumo fica melhor e gasta menos chamadas.
LOCAL_LLM_CONTEXT_TOKENS=8192

# Embeddings do modo educacao. Em "auto" a ordem e: endpoint proprio, LocalAI,
# Ollama, modelo local em processo, OpenAI e, por ultimo, o hash offline (que
# casa palavra igual mas nao entende sinonimo). O modelo local roda dentro do
# backend, sem chave e sem servidor externo: e o que garante que indexar aula
# nao pare porque uma API paga venceu.
EMBEDDING_PROVIDER=auto
EMBEDDING_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Onde guardar o modelo baixado (~220 MB). Vazio usa o cache do huggingface;
# em container efemero aponte para um volume, senao cada deploy baixa de novo.
EMBEDDING_CACHE_DIR=

# Redis backs per-IP rate limiting (fastapi-limiter). If unreachable, the
# backend still starts and rate limiting is simply skipped.
REDIS_URL=redis://localhost:6379/0

# Local speech-to-text.
# Com GPU NVIDIA, use cuda/float16: fica cerca de 7x mais rapido que cpu/int8
# com o mesmo acerto. Exige os pacotes nvidia-cublas-cu12 e nvidia-cudnn-cu12
# (ja em requirements.txt); o backend poe essas DLLs no PATH sozinho.
# Sem GPU, volte para cpu/int8.
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_VAD_FILTER=true
WHISPER_VAD_MIN_SILENCE_MS=500
WHISPER_REPETITION_PENALTY=1.1
WHISPER_NO_REPEAT_NGRAM_SIZE=3

# Speech providers
STT_PROVIDER=local
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=0.95

# =============================================================================
# Orquestracao, servicos e observabilidade
# =============================================================================

# Portas. Sao apenas padroes de desenvolvimento: nada e fixo no codigo.
#
# ATENCAO em PaaS (Railway, Render, Fly): a plataforma injeta `PORT` e roteia o
# trafego para ela. `PORT` tem precedencia sobre `ASSISTANT_API_PORT` justamente
# por isso - mas NAO copie a linha abaixo para as variaveis do deploy, ou voce
# fixa a porta local num ambiente onde ela nao vale.
ASSISTANT_API_PORT=8000
ORCHESTRATOR_PORT=8001
MCP_SERVICE_PORT=8002
TOOL_SERVICE_PORT=8003
OBSERVABILITY_PORT=8004

# Transporte de cada capacidade: `local` roda in-process, `remote` fala HTTP
# com o servico extraido. O padrao e local; nenhum agente percebe a diferenca.
TOOL_TRANSPORT=local
MCP_TRANSPORT=local
# Usadas quando o transporte e `remote`. Vazio deduz pela porta acima.
TOOL_SERVICE_URL=
MCP_SERVICE_URL=

# Resiliencia das chamadas a ferramentas.
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_RETRIES=1
TOOL_RETRY_BACKOFF_SECONDS=0.5

# Resiliencia do MCP. O disjuntor evita pagar timeout inteiro a cada mensagem
# quando um servidor ja se sabe fora do ar.
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=2
MCP_RETRY_BACKOFF_SECONDS=0.5
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_RESET_SECONDS=60
MCP_TOOLS_CACHE_TTL_SECONDS=300

# Checkpoint do grafo: `memory`, `sqlite` ou `none`. Em memoria cobre a
# retomada dentro da mesma sessao sem dependencia extra; `sqlite` sobrevive a
# restart, exige langgraph-checkpoint-sqlite instalado e um volume persistente.
#
# CHECKPOINT_MAX_THREADS limita quantas conversas ficam retidas em memoria. O
# checkpointer do LangGraph nunca descarta nada sozinho, entao sem teto um
# processo de vida longa acumula todo checkpoint ja gravado. ~7 KB por conversa
# de uma mensagem: 200 cobre uso normal com folga; suba em instancia grande,
# baixe em container pequeno.
CHECKPOINT_BACKEND=memory
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
CHECKPOINT_MAX_THREADS=200
GRAPH_NODE_MAX_RETRIES=2

# Tracing distribuido. Ligue apenas com um collector alcancavel: sem ele o SDK
# registra falha de envio a cada lote.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=assistant-api
OTEL_EXPORTER_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
TELEMETRY_MEMORY_EVENTS=2000

# Observabilidade dos fluxos de IA. Complementa - nao substitui - o tracing da
# aplicacao.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assistant-app
LANGSMITH_ENDPOINT=

# Preco por milhao de tokens, sobrescrevendo a tabela interna. Aceita a chave do
# provedor e a mais especifica "provedor:modelo".
# LLM_PRICING={"claude": {"input": 3.0, "output": 15.0, "cached_input": 0.3}}
LLM_PRICING=
