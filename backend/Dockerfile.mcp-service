# mcp-service: imagem propria, com o que o processo de fato carrega.
#
# Por que nao a imagem do backend: ela instala faster-whisper e os wheels de
# CUDA (nvidia-cublas-cu12, nvidia-cudnn-cu12), que sozinhos passam de 2 GB e
# que este servico nunca importa. Aqui sao ~100 MB de dependencias.
#
# O preco da escolha, para ficar registrado: um import de `app` em shared/* ou
# no entrypoint quebra este servico em RUNTIME, e nao no build - por isso ha
# teste de fronteira de import.
# tests/test_service_requirements.py cobre a deriva de versao; a de pacote so
# aparece quando o servico sobe, e por isso o healthcheck do deploy importa.

# --- CLI do cofre de segredos (Infisical) ------------------------------------------------
# Versao e hash fixados aqui, no repositorio: o build falha se o arquivo publicado mudar.
# Para atualizar: troque a versao e os dois hashes (checksums.txt da release, conferido).
FROM python:3.14-slim AS infisical

ARG TARGETARCH=amd64
ARG INFISICAL_CLI_VERSION=0.43.141
ARG INFISICAL_CLI_SHA256_AMD64=d93a9b5ae46c6097889926b95c1c09992f44619053793eaa61d66884726c95e5
ARG INFISICAL_CLI_SHA256_ARM64=2d18c7e43eee6f01be13bd94da2354cadfb8db14cc24bcd488e9317b277a2bbe

COPY docker/fetch_infisical.py /fetch_infisical.py
RUN case "${TARGETARCH}" in \
      arm64) SHA="${INFISICAL_CLI_SHA256_ARM64}" ;; \
      *) TARGETARCH=amd64; SHA="${INFISICAL_CLI_SHA256_AMD64}" ;; \
    esac \
    && python /fetch_infisical.py "${INFISICAL_CLI_VERSION}" "${TARGETARCH}" "${SHA}" /infisical

FROM python:3.14-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv

RUN python -m venv "${VIRTUAL_ENV}"
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

WORKDIR /build

COPY requirements-mcp-service.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install --only-binary=:all: -r requirements-mcp-service.txt


FROM python:3.14-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

# Servidor MCP com transporte stdio sobe SUBPROCESSO nesta imagem - `npx`, um
# binario, um script -, e o runtime dele precisa existir aqui. Node nao entra
# por padrao porque dobraria o tamanho da imagem sem que todo servidor precise
# dele. Se os seus MCP_SERVERS usam npx:
#
#   docker build -f Dockerfile.mcp-service --build-arg WITH_NODE=true .
#
# Servidores com transporte `http` nao tem esse requisito.
ARG WITH_NODE=false

# curl e o healthcheck do orquestrador de container. ffmpeg NAO entra: este
# servico nao transcreve audio.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && if [ "${WITH_NODE}" = "true" ]; then \
         apt-get install -y --no-install-recommends nodejs npm; \
       fi \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

# So o codigo que este processo carrega: o nucleo e o proprio entrypoint.
# `app/` nao entra - o mcp-service nao carrega nenhum modulo do produto, e
# tests/test_import_boundaries.py reprova o import que mudar isso. Sem essa
# garantia, faltar `app/` aqui so apareceria no boot do container.
COPY --chown=app:app shared ./shared
COPY --chown=app:app services ./services

# Cofre: busca os segredos no Infisical e sobe o processo com eles. Sem INFISICAL_* no
# ambiente, executa o comando direto. O "Start command" do Railway SUBSTITUI o ENTRYPOINT:
# quem usa um (o orquestrador) precisa chamar /usr/local/bin/infisical-entrypoint nele.
COPY --from=infisical /infisical /usr/local/bin/infisical
COPY docker/infisical-entrypoint.sh /usr/local/bin/infisical-entrypoint
RUN chmod 755 /usr/local/bin/infisical-entrypoint

USER app

# Documental. A porta efetiva vem de PORT (plataforma) ou MCP_SERVICE_PORT.
EXPOSE 8002

ENTRYPOINT ["/usr/local/bin/infisical-entrypoint"]
CMD ["python", "-m", "services.mcp_service.main"]
